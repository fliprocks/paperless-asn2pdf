{
    "name": "paperless-asn2pdf",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.example.asnpdf",
        "productName": "Paperless asn2pdf",
        "files": [
            "main.js",
            "index.html",
            "src/**/*",
            "package.json"
        ],
        "mac": {
            "target": "dmg"
        },
        "win": {
            "target": "portable"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "dependencies": {
        "bwip-js": "^4.7.0",
        "pdfkit": "^0.17.1"
    },
    "devDependencies": {
        "electron-builder": "^24.6.0"
    }
}
